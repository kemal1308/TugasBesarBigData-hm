import os
from pyspark.sql import SparkSession
from pyspark.sql import functions as F
from pyspark.sql.types import DateType, DoubleType, IntegerType, StringType

# ==========================================
# 1. INISIALISASI SPARK SESSION
# ==========================================
spark = SparkSession.builder \
    .appName("HM_Data_Cleaning_And_Parquet_Generation") \
    .config("spark.driver.memory", "8g") \
    .config("spark.executor.memory", "8g") \
    .config("spark.sql.shuffle.partitions", "200") \
    .getOrCreate()

spark.sparkContext.setLogLevel("WARN")

# Path data (Sesuaikan lokasi folder tempat file CSV berada)
DATA_DIR = "../data"  # atau "./data"
TRANS_PATH = os.path.join(DATA_DIR, "transactions_train.csv")
CUSTOMERS_PATH = os.path.join(DATA_DIR, "customers.csv")
ARTICLES_PATH = os.path.join(DATA_DIR, "articles.csv")
OUTPUT_PARQUET = os.path.join(DATA_DIR, "cleaned_hm_data.parquet")

print("Membaca file data mentah...")

# ==========================================
# 2. MEMUAT DATA MENTAH
# ==========================================
# Catatan: article_id dibaca sebagai StringType agar leading zero '0' tidak hilang
df_trans = spark.read.option("header", "true").csv(TRANS_PATH)
df_cust = spark.read.option("header", "true").csv(CUSTOMERS_PATH)
df_art = spark.read.option("header", "true").csv(ARTICLES_PATH)

# ==========================================
# 3. DATA CLEANING & TYPE CASTING
# ==========================================

# A. Pembersihan Data Transaksi
# - Konversi t_dat ke DateType
# - Konversi price ke DoubleType
# - Konversi sales_channel_id ke IntegerType
# - Buang baris dengan missing value pada kolom kunci
df_trans_clean = df_trans \
    .withColumn("t_dat", F.to_date(F.col("t_dat"), "yyyy-MM-dd")) \
    .withColumn("price", F.col("price").cast(DoubleType())) \
    .withColumn("sales_channel_id", F.col("sales_channel_id").cast(IntegerType())) \
    .filter(
        F.col("customer_id").isNotNull() & 
        F.col("article_id").isNotNull() & 
        (F.col("price") > 0)
    ) \
    .dropDuplicates()

# B. Pembersihan Data Pelanggan (Customers)
# - Konversi age ke Integer
# - Imputasi nilai kosong pada usia (opsional: median/rata-rata atau nilai default)
# - Menghapus duplikasi customer_id
avg_age = df_cust.select(F.avg(F.col("age").cast(IntegerType()))).first()[0]
df_cust_clean = df_cust \
    .withColumn("age", F.col("age").cast(IntegerType())) \
    .fillna({"age": int(avg_age) if avg_age else 30}) \
    .select("customer_id", "FN", "Active", "club_member_status", "age") \
    .dropDuplicates(["customer_id"])

# C. Pembersihan Data Artikel/Produk (Articles)
# - Ambil atribut utama produk agar ukuran Parquet tetap efisien
# - Pastikan tidak ada duplikasi pada article_id
df_art_clean = df_art \
    .select(
        "article_id",
        "product_type_name",
        "product_group_name",
        "graphical_appearance_name",
        "colour_group_name",
        "index_group_name",
        "garment_group_name"
    ) \
    .dropDuplicates(["article_id"])

# ==========================================
# 4. PENGGABUNGAN DATA (JOIN)
# ==========================================
print("Menggabungkan transaksi dengan metadata artikel dan pelanggan...")

# Join transaksi dengan artikel (menggunakan broadcast join jika metadata muat di memori)
df_joined = df_trans_clean \
    .join(F.broadcast(df_art_clean), on="article_id", how="inner") \
    .join(df_cust_clean, on="customer_id", how="inner")

# ==========================================
# 5. PEMILIHAN ATRIBUT & OPTIMASI PENYIMPANAN
# ==========================================
# Pilih kolom esensial yang diperlukan untuk EDA dan Model Rekomendasi MLlib
final_df = df_joined.select(
    "t_dat",
    "customer_id",
    "article_id",
    "price",
    "sales_channel_id",
    "age",
    "product_group_name",
    "product_type_name",
    "garment_group_name"
)

# ==========================================
# 6. EXPORT KE FORMAT PARQUET TERPARTISI
# ==========================================
print(f"Menyimpan data bersih ke: {OUTPUT_PARQUET}")

# Menggunakan mode overwrite dan partisi berbasis tahun/bulan atau write langsung
# Format Parquet memberikan kompresi Snappy bawaan yang sangat hemat ruang disk
final_df.write \
    .mode("overwrite") \
    .parquet(OUTPUT_PARQUET)

print("Proses pembuatan 'cleaned_hm_data.parquet' selesai dengan sukses!")
spark.stop()
