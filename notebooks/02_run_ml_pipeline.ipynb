import sys
sys.path.append("..")

from pyspark.sql import SparkSession
from src.config import DATA_INPUT_PARQUET, MODEL_INDEXER_DIR, MODEL_ALS_DIR, ALS_PARAMS
from src.preprocessing import create_implicit_ratings, fit_and_transform_indexers
from src.model import train_als_model, evaluate_model, get_top_recommendations

spark = SparkSession.builder.appName("ML_Notebook").getOrCreate()

# 1. Pipeline Preprocessing
df = spark.read.parquet(DATA_INPUT_PARQUET)
interactions = create_implicit_ratings(df)
indexed_df, _ = fit_and_transform_indexers(interactions, model_save_path=MODEL_INDEXER_DIR)

# 2. Training & Eval
train, test = indexed_df.randomSplit([0.8, 0.2], seed=42)
model = train_als_model(train, ALS_PARAMS, save_path=MODEL_ALS_DIR)
print(f"RMSE: {evaluate_model(model, test):.4f}")

# 3. Rekomendasi
get_top_recommendations(model, 5).show(5, truncate=False)
